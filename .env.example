# PlantVision AI — Environment Configuration
# Copy this file to ".env" in the same folder as app.py and fill in your keys.
# NEVER commit your actual ".env" file or share API keys publicly.

# ──────────────────────────────────────────────
# MODEL WEIGHTS (Optional)
# ──────────────────────────────────────────────
# Absolute or relative path to your trained YOLOv8 plant-disease weights.
# If not set, the app auto-discovers best.pt in common training run directories.
# If no trained weights are found, the app falls back to yolov8n.pt (COCO base model)
# and displays a clear warning in the dashboard.
#
# Example:
#   PLANTDOC_WEIGHTS=C:/Users/yourname/models/plant_best.pt
#   PLANTDOC_WEIGHTS=runs/detect/train/weights/best.pt
#
# PLANTDOC_WEIGHTS=

# ──────────────────────────────────────────────
# GOOGLE GEMINI API KEY (Required for chatbot + AI recommendations)
# ──────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_ap

# ──────────────────────────────────────────────
# OPENWEATHER API KEY (Required for Weather page)
# ──────────────────────────────────────────────
# Get your key at: https://home.openweathermap.org/api_keys
# Subscribe to "Current Weather Data" (free tier included).
# New keys may take up to 2 hours to activate.
OPENWEATHER_API_KEY=your_openweather_api_key_here
